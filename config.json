{
  "patterns": [
    {
      "name": "Critical Error",
      "regex": "CRITICAL|FATAL",
      "severity": "CRITICAL"
    },
    {
      "name": "Error",
      "regex": "ERROR",
      "severity": "ERROR"
    },
    {
