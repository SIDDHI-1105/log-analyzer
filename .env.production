# Production Environment Variables
# Copy this to .env and fill in real values before deploying

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=loganalyzer

# Security - CHANGE THIS! Use a strong random string (min 32 chars)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-immediately

# Application
DEBUG=False
