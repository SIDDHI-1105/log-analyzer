# Application
DEBUG=True
APP_NAME=Log Analyzer API
APP_VERSION=0.2.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loganalyzer

# Security
JWT_SECRET_KEY=change-this-to-a-secure-random-string-min-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

# Server
HOST=0.0.0.0
PORT=8000
